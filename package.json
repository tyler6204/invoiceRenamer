{
  "private": true,
  "name": "invoice-renamer",
  "description": "This tool renames invoices to a more readable format for accounting purposes.",
  "version": "1.1.1",
  "author": "Tyler Yust <tyler@yusttech.com>",
  "main": "app/background.js",
  "repository": "https://github.com/tyler6204/invoiceRenamer",
  "publish": {
    "repository": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "scripts": {
    "dev": "cross-env $(grep -v '^#' .env | xargs) nextron",
    "build": "cross-env $(grep -v '^#' .env | xargs) nextron build",
    "build-mac": "cross-env $(grep -v '^#' .env | xargs) nextron build && cross-env $(grep -v '^#' .env | xargs) electron-builder --mac",
    "build-win": "cross-env $(grep -v '^#' .env | xargs) nextron build && cross-env $(grep -v '^#' .env | xargs) electron-builder --win --x64",
    "build-all": "cross-env $(grep -v '^#' .env | xargs) nextron build && cross-env $(grep -v '^#' .env | xargs) electron-builder --mac --win --x64",
    "publish": "cross-env $(grep -v '^#' .env | xargs) nextron build && cross-env $(grep -v '^#' .env | xargs) electron-builder --mac --win --x64 --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "extraFiles": [
    {
      "from": "main/preload.js",
      "to": "app/preload.js"
    }
  ],
  "dependencies": {
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.22",
    "@babel/runtime-corejs3": "^7.27.6",
    "@electron/packager": "^18.3.6",
    "@google/genai": "^1.5.1",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "ai": "^4.3.16",
    "call-bound": "^1.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conf": "^13.1.0",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "electron-log": "^5.4.1",
    "electron-serve": "^1.3.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.5",
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.485.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "4.8.69",
    "react": "^19.1.0",
    "react-day-picker": "9.6.3",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-pdf": "^9.2.1",
    "sonner": "^2.0.5",
    "spawn-sync": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-to-css": "^0.0.6",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.4",
    "tw-to-css": "^0.0.12",
    "webpack": "^5.99.9",
    "zod": "^3.25.67"
  },
  "resolutions": {
    "@electron/notarize": "2.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.29.0",
    "next": "15.2.4",
    "nextron": "^9.5.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "build": {
    "appId": "com.yusttech.invoicerenamer",
    "productName": "Invoice Renamer",
    "icon": "resources/logo.png",
    "files": [
      "app/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "resources/logo.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Tyler Yust (3982L8EWZ8)",
      "notarize": true
    },
    "win": {
      "icon": "resources/logo.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "icon": "resources/logo.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tyler6204",
        "repo": "invoiceRenamer",
        "private": true,
        "releaseType": "release"
      }
    ],
    "extraResources": [
      { "from": ".env", "to": ".env" }
    ]
  }
}
